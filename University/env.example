# ============================================
# Environment Configuration
# ============================================
# Copy this file to .env.local and update the values
# When deploying to Cloudflare, update these URLs

# ============================================
# API Configuration
# ============================================

# Go Backend API URL
# Local Development:
NEXT_PUBLIC_GO_API_URL=http://localhost:7000

# Production (Cloudflare Tunnel):
# NEXT_PUBLIC_GO_API_URL=https://api.yourdomain.com

# Alternative API URL (if needed)
# NEXT_PUBLIC_API_URL=http://localhost:7000

# ============================================
# Deployment Instructions
# ============================================
# 
# For Cloudflare Tunnel:
# 1. Run: sudo ./setup-cloudflare-tunnel.sh
# 2. Update NEXT_PUBLIC_GO_API_URL to your Cloudflare domain
# 3. Restart your Next.js app: pnpm dev (or pm2 restart)
# 
# For Nginx:
# 1. Run: sudo ./setup-nginx-proxy.sh
# 2. Update NEXT_PUBLIC_GO_API_URL to your domain
# 3. Restart your Next.js app
#
# ============================================
